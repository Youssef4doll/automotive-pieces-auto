# Neon Postgres — pooled connection (PgBouncer, "-pooler" host) for normal
# app traffic. Get both values from your Neon project's Connection Details.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# Neon Postgres — direct/unpooled connection (no "-pooler" in the host),
# used only for `prisma migrate` (PgBouncer's transaction pooling doesn't
# support the session-level features migrations need).
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

SESSION_SECRET="change-me-to-a-long-random-string"
NODE_ENV="development"
