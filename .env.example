# Supabase Postgres — Transaction pooler connection (port 6543) for normal
# app traffic. Get it from Supabase dashboard -> Project Settings ->
# Database -> Connection string -> "Transaction pooler" tab. The
# `pgbouncer=true` flag is required: it tells Prisma to skip prepared
# statements, which the pooler's transaction mode doesn't support.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Postgres — direct connection (port 5432), used only for
# `prisma migrate` (the pooler's transaction mode doesn't support the
# session-level features migrations need). Requires IPv6 — if your network
# is IPv4-only, use the "Session pooler" string instead (same pooler.supabase.com
# host, port 5432).
DATABASE_URL_UNPOOLED="postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

SESSION_SECRET="change-me-to-a-long-random-string"
NODE_ENV="development"
