# Postgres connection for normal app traffic. The project has been run
# against both Neon and Supabase; either works the same way here.
#
#   Neon     — the pooled string, hostname carries "-pooler". Console:
#              Project -> Connect, or `neon env pull` writes it for you.
#   Supabase — Project Settings -> Database -> Connection string ->
#              "Transaction pooler" tab (port 6543). The `pgbouncer=true`
#              flag is required there: it tells Prisma to skip prepared
#              statements, which the pooler's transaction mode doesn't
#              support.
DATABASE_URL="postgresql://user:password@ep-xxxxxxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Direct/unpooled connection, used only for `prisma migrate` — a pooler's
# transaction mode doesn't support the session-level features migrations
# need.
#
#   Neon     — the same string as DATABASE_URL with "-pooler" dropped from
#              the hostname; same user, password, database and port.
#   Supabase — same credentials on host db.<ref>.supabase.co, port 5432 — or
#              the "Session pooler" string on port 5432 if your network is
#              IPv4-only.
#
# REQUIRED WHEREVER DATABASE_URL IS POOLED — including on Vercel, where a
# missing one fails the build before it reaches the database. If DATABASE_URL
# is already a direct connection (a plain Postgres server, a local database),
# leave this out: scripts/prisma.mjs fills it in from DATABASE_URL, and refuses
# to do so when it can see a pooler in the string.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxxxxxx.region.aws.neon.tech/dbname?sslmode=require"

SESSION_SECRET="change-me-to-a-long-random-string"
NODE_ENV="development"

# ---------------------------------------------------------------- e-mail --
# Optional. With none of this set the site still works and still takes orders;
# it simply tells nobody about them — see the banner in /admin/parametres.
#
# The envelope sender. With Resend it must be on a domain you have verified
# in their dashboard, or the API refuses the message.
# EMAIL_FROM="Automotive Pièces Auto <commandes@votre-domaine.tn>"
#
# Pick ONE transport.
#
# 1) Resend — recommended: no package to install, it is called over plain HTTPS.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
#
# 2) SMTP — your own mail server or your host's. Needs `npm i nodemailer`.
# SMTP_HOST="smtp.votre-hebergeur.tn"
# SMTP_PORT="587"
# SMTP_USER="commandes@votre-domaine.tn"
# SMTP_PASS="..."

# ----------------------------------------------------------- Cloudflare --
# Leave this OUT unless a Cloudflare proxy is genuinely in front of the site
# (orange cloud, SSL mode "Full (strict)"), and set it in the SAME change that
# turns the proxy on.
#
# It tells the rate limiter to read CF-Connecting-IP instead of the leftmost
# x-forwarded-for hop. Two things go wrong if it is out of step with reality:
#
#   set when there is no Cloudflare → anybody can send CF-Connecting-IP, so
#     every request gets its own bucket and the limiter is off while still
#     appearing to work;
#   unset when there is one → the leftmost hop may be Cloudflare's edge, so
#     the whole country shares one bucket and legitimate shoppers are refused
#     at 40 checkouts per ten minutes between them.
#
# TRUST_CLOUDFLARE_IP="1"

# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX.
#
# Optional, and the site is deliberately different without it: no analytics
# script is rendered AND the Content-Security-Policy stays closed to every
# third-party host. Setting this opens both, together, so the policy and the
# page can never disagree. /confidentialite reads the same variable and names
# Google Analytics only when it is actually running.
#
# Google Analytics sets cookies. Whether that needs a consent banner where you
# trade is a question for a lawyer, not for this file.
NEXT_PUBLIC_GA_ID=
