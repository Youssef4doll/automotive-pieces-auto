// Automotive Pieces Auto — database schema
// One database drives both the public storefront and the admin CRM,
// so anything an admin changes (stock, price, order status, settings)
// is reflected immediately on the storefront.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer, "-pooler" host) for normal app traffic —
  // required on serverless/edge runtimes like Vercel, which open many
  // short-lived connections.
  url       = env("DATABASE_URL")
  // Direct/unpooled connection for schema migrations (prisma migrate),
  // which need session-level Postgres features PgBouncer's transaction
  // pooling mode doesn't support.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum DeliveryMethod {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  COD
  CARD
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum CustomerSegment {
  NEW
  REGULAR
  VIP
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         Role      @default(CUSTOMER)
  segment      CustomerSegment @default(NEW)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  orders       Order[]
  reviews      Review[]

  @@index([role])
  carts     Cart[]
}

model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  logoUrl   String?
  isPartsBrand Boolean @default(true) // parts brand (Kamoka, Bosch..) vs vehicle make brand
  products  Product[]
}

model Category {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  order        Int        @default(0)
  parentId     String?
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryTree")
  products     Product[]
}

model VehicleMake {
  id      String         @id @default(cuid())
  name    String         @unique
  slug    String         @unique
  logoUrl String?
  models  VehicleModel[]
}

model VehicleModel {
  id        String         @id @default(cuid())
  makeId    String
  make      VehicleMake    @relation(fields: [makeId], references: [id], onDelete: Cascade)
  name      String
  /// URL form of the name, unique within the make. Someone searching for
  /// "plaquettes clio 4" should land on a page about that car, and a page
  /// needs an address — /pieces/renault/clio-iv.
  slug      String         @default("")
  yearFrom  Int?
  yearTo    Int?
  engines   VehicleEngine[]

  @@unique([makeId, name])
  @@unique([makeId, slug])
  @@index([makeId])
}

model VehicleEngine {
  id        String        @id @default(cuid())
  modelId   String
  model     VehicleModel  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  name      String        // e.g. "1.5 dCi"
  fuel      String?       // essence / diesel
  powerHp   Int?
  // The engine code (K9K, CDTI, TDI…) is what distinguishes two engines a
  // catalogue calls by the same commercial name, and it is what supplier
  // fitment data is keyed on. Without it, imported compatibility cannot be
  // matched reliably.
  engineCode String?
  displacementCc Int?
  yearFrom  Int?
  yearTo    Int?
  fitments  ProductFitment[]

  @@unique([modelId, name])
  @@index([modelId])
  @@index([engineCode])
}

model Product {
  id            String   @id @default(cuid())
  sku           String   @unique // reference stamped on the part
  name          String
  slug          String   @unique
  brandId       String?
  brand         Brand?   @relation(fields: [brandId], references: [id])
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  description   String   @default("")
  imageUrl      String   @default("/images/parts-lineup.png")
  oemRefs       String[] @default([])
  specs         Json     @default("{}")
  priceBuy      Decimal  @default(0) @db.Decimal(10, 2)  // prix d'achat
  priceSell     Decimal  @db.Decimal(10, 2)               // prix de vente
  compareAtPrice Decimal? @db.Decimal(10, 2)              // struck-through reference price
  currency      String   @default("TND")
  stockQty      Int      @default(0)
  lowStockThreshold Int  @default(5)
  isTopSeller   Boolean  @default(false)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Everything a shopper might type to reach this part, in one accent-free
  /// lower-case blob: name, brand, category, family, SKU and every reference.
  /// Rebuilt in SQL by reindexProducts(), never written by hand — see
  /// src/lib/search. A trigram index on it is what makes a misspelled query
  /// still find the part, and what keeps that possible at 50 000 rows.
  searchText    String   @default("")
  /// The SKU with every separator stripped: "BR-4820" → "BR4820". Part
  /// numbers are written down differently by everyone, so they are matched in
  /// this space and never literally. Derived, like searchText.
  skuNormalized String   @default("")
  /// Every OEM number in the same stripped form, so "77 01 234 567" finds the
  /// part someone typed as "7701234567".
  refsNormalized String[] @default([])

  // Position is the difference between the right part and an expensive
  // return. Held as structured fields, never parsed back out of the name.
  axle          Axle?
  side          Side?
  /// Set by the import batch that last touched this row, so an import is
  /// reversible and its products are traceable to their source file.
  importBatchId String?

  fitments      ProductFitment[]
  references    PartReference[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  reviews       Review[]
  stockMoves    StockMovement[]
  images        ProductImage[]

  @@index([categoryId])
  @@index([brandId])
  @@index([importBatchId])
  @@index([skuNormalized])
}

enum Axle {
  AVANT
  ARRIERE
}

enum Side {
  GAUCHE
  DROITE
}

// Photos live in Postgres rather than on disk so they survive a redeploy and
// work on hosts with a read-only filesystem, and so a database backup carries
// the shop's pictures with it. Bytes are served by /api/images/[id].
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String
  alt       String   @default("")
  // 0 is the primary photo: the one shown on cards, in the cart and in search.
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, order])
}

model ProductFitment {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  engineId  String
  engine    VehicleEngine @relation(fields: [engineId], references: [id], onDelete: Cascade)
  // How much we actually trust this row. VERIFIED comes from a supplier
  // catalogue or a confirmed delivery; DERIVED was inferred from a shared
  // reference. The storefront must never present the two as equally certain.
  confidence FitmentConfidence @default(VERIFIED)
  note      String?           // e.g. "châssis à partir de 2016"
  source    String?           // supplier catalogue, manual, customer confirmation

  @@unique([productId, engineId])
  @@index([engineId])
}

enum FitmentConfidence {
  VERIFIED
  DERIVED
}

enum ReferenceType {
  OEM        // constructor's own number, stamped on the original part
  AFTERMARKET // the manufacturer's own catalogue number
  EQUIVALENT  // a competing brand's number for the same part
}

/// The lookup key of the parts trade: a mechanic reads the number off the old
/// part and types it in. `normalized` strips separators and case so that
/// "GDB 1330", "gdb-1330" and "GDB1330" all resolve to the same row.
model PartReference {
  id         String        @id @default(cuid())
  productId  String
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  type       ReferenceType
  brand      String?       // whose number this is (Renault, TRW, Bosch…)
  raw        String        // exactly as printed, for display
  normalized String        // uppercase alphanumerics only, for matching
  createdAt  DateTime      @default(now())

  @@unique([productId, type, normalized])
  @@index([normalized])
  @@index([productId])
}

enum CartStatus {
  ACTIVE
  CONVERTED // became an order
  ABANDONED // untouched long enough to be worth chasing
}

/// The cart existed only in the shopper's browser, which made it invisible to
/// the business: an abandoned basket could not be recovered, and a customer who
/// moved from phone to laptop lost it. Holding it server-side turns the single
/// biggest source of lost revenue into something we can see and act on.
model Cart {
  id         String     @id @default(cuid())
  /// Set once the shopper signs in; the anonymous cart is merged into it.
  userId     String?
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Anonymous identity, from the same cookie analytics uses.
  sessionId  String?
  status     CartStatus @default(ACTIVE)
  /// Captured at checkout so an abandoned cart can actually be followed up.
  phone      String?
  orderId    String?    @unique
  /// When a recovery message was last sent, so nobody is chased twice.
  remindedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]

  @@index([userId])
  @@index([sessionId])
  @@index([status, updatedAt])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty       Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([cartId, productId])
  @@index([productId])
}

enum ImportStatus {
  DRAFT      // uploaded and parsed, not yet applied
  APPLIED
  ROLLED_BACK
  FAILED
}

/// Every catalogue import is a reversible batch. Rows created or updated by a
/// batch are tagged with its id, so a bad supplier file can be undone instead
/// of hand-corrected across thousands of products.
model ImportBatch {
  id          String       @id @default(cuid())
  filename    String
  status      ImportStatus @default(DRAFT)
  rowCount    Int          @default(0)
  createdCount Int         @default(0)
  updatedCount Int         @default(0)
  skippedCount Int         @default(0)
  errorCount   Int         @default(0)
  /// Parsed rows plus per-row validation verdicts, kept so the preview and the
  /// apply step operate on exactly the same data.
  payload     Json         @default("[]")
  report      Json         @default("{}")
  createdById String?
  createdAt   DateTime     @default(now())
  appliedAt   DateTime?

  @@index([status, createdAt])
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  change    Int      // positive = restock, negative = sold/adjusted
  reason    String   // "order", "restock", "adjustment"
  note      String?
  createdAt DateTime @default(now())

  @@index([productId])
}

model Order {
  id             String         @id @default(cuid())
  ref            String         @unique // e.g. CMD-1042
  userId         String?
  user           User?          @relation(fields: [userId], references: [id])
  customerName   String
  phone          String
  email          String?
  governorate    String
  address        String?
  deliveryMethod DeliveryMethod @default(DELIVERY)
  paymentMethod  PaymentMethod  @default(COD)
  status         OrderStatus    @default(PENDING)
  subtotal       Decimal        @db.Decimal(10, 2)
  shippingFee    Decimal        @db.Decimal(10, 2) @default(0)
  total          Decimal        @db.Decimal(10, 2)
  notes          String?
  // First-touch marketing attribution, carried from the visitor's first
  // page load through to the order that eventually resulted — this is
  // what lets "campaign X generated Y TND" be answered from real data
  // instead of guessed. All nullable: a returning visitor with no stored
  // attribution, or an admin-created order, simply has none.
  source         String?
  medium         String?
  campaign       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items          OrderItem[]
  history        OrderStatusEvent[]

  @@index([status])
  @@index([userId])
  @@index([source])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String   // snapshot
  sku       String   // snapshot
  imageUrl  String   @default("/images/parts-lineup.png")
  unitPrice Decimal  @db.Decimal(10, 2)
  qty       Int
  lineTotal Decimal  @db.Decimal(10, 2)

  @@index([orderId])
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model Review {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  authorName  String
  rating      Int
  comment     String
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([productId])
}

model Setting {
  key   String @id
  value String
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Admin-managed promotional banners shown as the homepage deals carousel.
// Kept as its own table rather than hardcoded JSX so the shop can rotate
// deals without a redeploy — which is the whole point of a deals strip.
// Where a banner appears. Two surfaces, deliberately separate: the strip at
// the very top of the home page is a static grid the shopper scans on
// arrival, while the campaign carousel sits mid-page and rotates. Artwork
// sized for one looks wrong in the other, so the admin picks per banner.
enum PromotionPlacement {
  HERO
  CAMPAIGN
}

// The three things this shop actually runs campaigns for. Shown as a small
// label on the slide, so a shopper can tell a seasonal push from a price cut
// before reading the artwork.
enum CampaignKind {
  SEASONAL
  NEW_ARRIVALS
  DEAL
}

model Promotion {
  id        String             @id @default(cuid())
  title     String // used as the image alt text — required, for accessibility
  imageUrl  String
  href      String? // where the banner links, e.g. /catalogue/freinage
  placement PromotionPlacement @default(HERO)
  kind      CampaignKind? // campaign slides only; null on hero banners
  order     Int                @default(0)
  active    Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([active, placement, order])
}

// An image uploaded by the admin that belongs to no product — today, banner
// artwork. Kept in Postgres like ProductImage so a deploy carries no file
// system state, and served by the same /api/images/[id] route: one URL space
// for every uploaded picture on the site.
model MediaAsset {
  id        String   @id @default(cuid())
  data      Bytes
  mimeType  String
  createdAt DateTime @default(now())
}

/// A search that found nothing.
///
/// This is the most direct demand signal the shop ever receives: a customer
/// saying, in their own words, what they came to buy and could not. Kept as
/// one row per distinct query with a counter rather than one row per search,
/// so the buying list reads as "nineteen people wanted a Clio IV timing kit",
/// not as a log to be waded through.
model SearchMiss {
  id         String    @id @default(cuid())
  /// Folded, de-accented, synonym-expanded — so "plaquete" and "Plaquettes"
  /// are one line on the buying list, not two.
  normalized String    @unique
  /// The last raw spelling seen, for reading back what was actually typed.
  query      String
  count      Int       @default(1)
  /// Set when the shop has acted on it (ordered the part, or decided not to).
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())

  @@index([resolvedAt, count])
  @@index([lastSeenAt])
}

// First-party product analytics — no external service, no keys required.
// Deliberately has no FK/relation to User: an event log is append-only and
// high-volume, and shouldn't gain a cascade-delete dependency on accounts
// or slow down under referential-integrity checks on every insert.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  name       String // e.g. "product_viewed", "add_to_cart", "checkout_completed"
  sessionId  String // anonymous, persisted client-side (apa-session cookie)
  userId     String?
  path       String?
  properties Json?
  createdAt  DateTime @default(now())

  @@index([name])
  @@index([sessionId])
  @@index([createdAt])
}
